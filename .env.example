# =================================================================
# CF Clearance Scraper 配置文件
# =================================================================

# 服务端口
PORT=3000

# API认证令牌 (可选)
# AUTH_TOKEN=your_secret_token

# 请求超时时间 (毫秒)
TIMEOUT=300000

# 页面加载超时时间 (毫秒)
PAGE_TIMEOUT=90000

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=100

# 内存管理
MAX_MEMORY_USAGE=4096
MEMORY_CLEANUP_INTERVAL=300000

# 浏览器实例限制
BROWSER_LIMIT=25

# 全局处理限制
MAX_PROCESSING_LIMIT=100
MAX_WAITING_POOL_SIZE=300
WAITING_POOL_TIMEOUT=600000

# 自动重启配置
AUTO_RESTART_ENABLED=true
AUTO_RESTART_TIME=00:05

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=CRITICAL

# 运行环境 (development, production, test)
NODE_ENV=production
